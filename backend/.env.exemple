# Copier ce fichier en « .env » et adapter. Ne jamais committer « .env ».

# Clé secrète Django : une longue chaîne aléatoire, différente en production.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=a-changer
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Base de données. Sans cette ligne : SQLite (fichier db.sqlite3).
# DATABASE_URL=postgres://wanda:motdepasse@localhost:5432/wanda

# Origines autorisées pour le web (le mobile n'en a pas besoin).
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Codes de connexion.
#   console : le code est écrit dans le journal du serveur (développement)
#   twilio  : envoi par WhatsApp via Twilio
OTP_FOURNISSEUR=console
# Numéros de test : code fixe, aucun envoi.
OTP_NUMEROS_TEST=+237690000001=123456,+237690000002=123456
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Notifications push Firebase (facultatif) : chemin du fichier de compte de
# service. Sans lui, les notifications sont seulement enregistrées en base.
# FCM_COMPTE_SERVICE=/chemin/vers/firebase-service-account.json
